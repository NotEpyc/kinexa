# Copy this file to .env and replace the password with your local PostgreSQL password.
# Keep .env private; it is ignored by Git.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/kinexa

# Generate a random secret (at least 32 characters) for signing login tokens.
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
# Set true behind HTTPS in production; keep false for local HTTP development.
AUTH_COOKIE_SECURE=false

# Optional. The application uses its registered default model when omitted.
# KINEXA_QUALITY_MODEL=squat_rf_v1
